# Copy sang .env khi chạy backend trên host.
# File SQLite duy nhất chứa dữ liệu nghiệp vụ (chạy ngoài Docker Compose).
DATABASE_PATH=./awing.db
# Cổng Uvicorn.
PORT=8000
# Origin của Frontend (CORS). Có thể khai nhiều origin, phân tách bằng dấu phẩy.
# FRONTEND_ORIGINS[0] cũng là gốc của redirect URI Google OAuth:
# {FRONTEND_ORIGIN}/api/backend/auth/google/callback — URI này phải đăng ký
# trong Google Cloud console (OAuth client) thì Google mới chấp nhận.
FRONTEND_ORIGIN=http://localhost:3000
# Google OAuth (đăng nhập người dùng cuối). Tạo trên Google Cloud Console.
# Để trống thì GET /api/auth/google trả lỗi cấu hình rõ ràng, không crash.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Secret ký JWT cho phiên người dùng cuối. BẮT BUỘC đặt giá trị ngẫu nhiên
# khi chạy thật; giá trị mặc định chỉ để chạy thử local.
JWT_SECRET=doi-secret-nay-khi-chay-that
# Secret kiểm tra webhook từ Strapi (đặt trùng với cấu hình webhook bên Strapi).
# Để trống thì chấp nhận mọi webhook (chỉ dùng khi thử nghiệm local).
STRAPI_WEBHOOK_SECRET=
# BE 18-20 — tìm kiếm trên FastAPI (không Meilisearch): URL Strapi để đọc
# nội dung công khai làm chỉ mục. Để trống thì /api/search chỉ dùng chỉ mục
# dự phòng (6 sản phẩm + 26 solution).
STRAPI_URL=http://localhost:1337
SEARCH_CACHE_TTL_SECONDS=300
# BE 8 — cầu revalidate sang Next.js (webhook Strapi → xóa tag cache FE).
# FRONTEND_URL là origin của Next.js; REVALIDATE_SECRET phải trùng với
# REVALIDATE_SECRET trong .env.local của Frontend. Để trống secret thì
# FastAPI bỏ qua bước revalidate (chỉ còn SSE content-updated).
FRONTEND_URL=http://localhost:3000
REVALIDATE_SECRET=<redacted>
# Tăng trưởng số liệu mẫu theo thời gian thực (tran 18/11/2026): mỗi chu kỳ
# 30 giây, backend cộng dồn số liệu vào SQLite rồi đẩy snapshot mới — số
# trên giao diện tăng dần. Chỉ cộng vào các số đã có (NULL giữ NULL, DB rỗng
# thì không làm gì). Số tăng là tổng hợp cho dữ liệu mẫu; khi có nguồn số
# liệu thật thì tắt (false) và thay bằng ingestion thật.
GROWTH_ENABLED=true
# Số lượt kết nối cộng thêm mỗi chu kỳ. Các số khác (reach, engagements,
# impressions/ngày, monthly) tăng theo cùng tỉ lệ % so với tổng hiện tại.
GROWTH_CONNECTIONS_PER_CYCLE=100000

# Lead form R1-2 (BE 11-14). Chưa chốt CRM / email / Turnstile (quyết định
# #1, #4) nên backend chạy ở chế độ GIẢ LẬP: OTP + email + CRM chỉ ghi log.
# Turnstile: secret key Cloudflare. Để trống = chấp nhận mọi token (ghi log).
TURNSTILE_SECRET=
# Email: "fake" = chỉ ghi log, không gửi thật. "ses"/"sendgrid" chưa cài đặt.
EMAIL_PROVIDER=fake
EMAIL_FROM=no-reply@awing.vn
# OTP: hiệu lực (phút), số lần nhập sai tối đa, cooldown gửi lại (giây).
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
# Token lead sau xác thực OTP (phút) — dùng cho PATCH /api/leads/{id}.
LEAD_TOKEN_EXPIRE_MINUTES=60
# Rate limit tạo lead: số request / phút / IP.
LEAD_RATE_LIMIT_PER_MINUTE=5
# BE 15-17: thư mục lưu file CV (BE 16) + hạn link xác nhận newsletter (ngày, BE 17).
UPLOADS_DIR=./uploads
NEWSLETTER_CONFIRM_TTL_DAYS=7
